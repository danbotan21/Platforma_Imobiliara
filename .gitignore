# ============================================================
# Dependencies and package-manager caches
# ============================================================
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ============================================================
# Generated frontend builds and deployment output
# ============================================================
dist/
build/
out/
.output/
.vercel/
.netlify/
.firebase/

# ============================================================
# Vite, TypeScript and bundler caches
# ============================================================
.vite/
.cache/
.parcel-cache/
.turbo/
.swc/
*.tsbuildinfo
vite.config.*.timestamp-*

# ============================================================
# Environment variables
# Keep real values local; commit only documented templates.
# ============================================================
.env
.env.*
!.env.example
!.env.*.example
!.env.template

# ============================================================
# Credentials, certificates and private keys
# These must never be committed to a frontend repository.
# ============================================================
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json

# ============================================================
# Logs and diagnostic output
# ============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# Generated test, coverage and UI-tool output
# ============================================================
coverage/
.nyc_output/
playwright-report/
test-results/
cypress/screenshots/
cypress/videos/
storybook-static/

# ============================================================
# Local editor settings
# ============================================================
.vscode/
.idea/
.fleet/
*.code-workspace

# ============================================================
# Operating-system files
# ============================================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================
# Temporary and backup files
# ============================================================
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
# Local Linux dependencies generated through WSL
_node_modules_linux/
_node_modules_linux.previous/
_node_modules_linux.tar.gz
._linux_modules_build/
